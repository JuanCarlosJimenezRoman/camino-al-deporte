// Esquema de base de datos - Camino al Deporte
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles y usuarios
// ---------------------------------------------------------------------------

enum RolNombre {
  ADMIN_PRINCIPAL // acceso total: usuarios, roles, catálogos, inventario, ventas, reportes
  DESARROLLO      // acceso total + puede crear/modificar campos personalizados
  INVENTARIO      // gestiona productos, variantes, entradas/salidas de stock
  VENTAS          // registra ventas, consulta stock, no edita catálogo
  CONSULTA        // solo lectura: existencias y precios
}

model Rol {
  id        Int       @id @default(autoincrement())
  nombre    RolNombre @unique
  descripcion String?
  usuarios  Usuario[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("roles")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  rol          Rol      @relation(fields: [rolId], references: [id])
  activo       Boolean  @default(true)
  ultimoLogin  DateTime? @map("ultimo_login")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Sucursal "de casa" del usuario. Null para ADMIN_PRINCIPAL/DESARROLLO,
  // que ven todas las sucursales. Para INVENTARIO/VENTAS/CONSULTA acota
  // qué sucursal ve por defecto en el frontend (no es una restricción dura
  // a nivel API todavía, ver docs/ARQUITECTURA.md).
  sucursalId   Int?     @map("sucursal_id")
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])

  movimientos  MovimientoInventario[]
  ventas       Venta[]
  ventaEdiciones VentaEdicion[]
  transferenciasSolicitadas TransferenciaInventario[] @relation("TransferenciasSolicitadas")
  transferenciasRecibidas   TransferenciaInventario[] @relation("TransferenciasRecibidas")
  apartadosCreados          Apartado[]      @relation("ApartadosCreados")
  pagosApartadoRegistrados  ApartadoPago[]  @relation("PagosApartadoRegistrados")
  pedidosValidados          Pedido[]        @relation("PedidosValidados")
  pagosProveedorRegistrados PagoProveedor[] @relation("PagosProveedorRegistrados")
  solicitudesCreadas        SolicitudPermiso[] @relation("SolicitudesCreadas")
  solicitudesRevisadas      SolicitudPermiso[] @relation("SolicitudesRevisadas")
  notificaciones            Notificacion[]
  cuponesCreados            Cupon[]
  pedidosDescuentoAplicado  Pedido[] @relation("PedidosDescuentoAplicado")
  // Pedidos capturados a mano por este usuario a partir de un pedido que
  // llegó por otro canal (WhatsApp, Instagram, etc.) — ver Pedido.origen y
  // Pedido.creadoPorId más abajo. Null en un pedido = lo armó el cliente
  // mismo desde el checkout de la tienda en línea.
  pedidosCreadosManualmente Pedido[] @relation("PedidosCreadosManualmente")

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Sucursales / bodegas
// ---------------------------------------------------------------------------

model Sucursal {
  id              Int      @id @default(autoincrement())
  nombre          String
  codigo          String?  @unique
  direccion       String?
  telefono        String?
  // ID del número de WhatsApp Business Platform (Cloud API de Meta) de esta
  // sucursal, para mandar el ticket digital automáticamente por API en vez
  // del link manual de wa.me — NO es el número de teléfono visible, es el
  // "Phone Number ID" que da Meta al conectar el número. Mientras esté
  // vacío, se sigue usando el envío manual (ver whatsapp.js y ventas.js).
  whatsappPhoneNumberId String? @map("whatsapp_phone_number_id")
  esBodegaCentral Boolean  @default(false) @map("es_bodega_central")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  usuarios        Usuario[]
  existencias     Existencia[]
  movimientos     MovimientoInventario[]
  ventas          Venta[]
  transferenciasOrigen  TransferenciaInventario[] @relation("TransferenciaOrigen")
  transferenciasDestino TransferenciaInventario[] @relation("TransferenciaDestino")
  apartadosStock  ApartadoItem[] @relation("ApartadoStock")
  apartadosVenta  Apartado[]     @relation("ApartadoVenta")
  pedidosStock    PedidoItem[]   @relation("PedidoStock")

  @@map("sucursales")
}

// Stock de una variante (talla/color) en una sucursal específica. El
// catálogo (producto/variante/SKU) es global; el stock es por sucursal.
//
// Desde que se separó el stock por proveedor, cada variante puede tener
// VARIOS renglones de existencia en la misma sucursal — uno por cada
// proveedor que la ha surtido ahí (antes era un solo número por
// sucursal+variante). proveedorId puede ser null: es el "renglón sin
// clasificar" (stock cargado antes de esta función, o conteos donde no se
// sabe/importa el origen). Ver migración 20260813090000_stock_por_proveedor
// para el índice único parcial que evita duplicar ese renglón sin proveedor
// (en Postgres NULL no cuenta como igual a otro NULL en un índice normal).
model Existencia {
  id          Int              @id @default(autoincrement())
  sucursalId  Int              @map("sucursal_id")
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id])
  varianteId  Int              @map("variante_id")
  variante    ProductoVariante @relation(fields: [varianteId], references: [id])
  proveedorId Int?             @map("proveedor_id")
  proveedor   Proveedor?       @relation(fields: [proveedorId], references: [id])
  stockActual Int              @default(0) @map("stock_actual")
  stockMinimo Int              @default(0) @map("stock_minimo")

  @@unique([sucursalId, varianteId, proveedorId])
  @@map("existencias")
}

// ---------------------------------------------------------------------------
// Catálogos: marcas, modelos, tallas, categorías
// ---------------------------------------------------------------------------

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  modelos   Modelo[]
  productos Producto[]

  @@map("marcas")
}

model Modelo {
  id        Int        @id @default(autoincrement())
  nombre    String
  marcaId   Int        @map("marca_id")
  marca     Marca      @relation(fields: [marcaId], references: [id])
  activo    Boolean    @default(true)
  productos Producto[]

  @@unique([nombre, marcaId])
  @@map("modelos")
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)

  // Portada para la tarjeta de categoría de la tienda en línea (opcional):
  // si no se sube ninguna, el frontend cae a una foto de un producto real de
  // esa categoría (ver app/(store)/tienda/(shop)/page.tsx). Se guarda en
  // Cloudinary igual que las fotos de producto; publicId es lo que permite
  // borrarla de allá al reemplazarla o quitarla (ver routes/catalogos.js).
  imagenPortada         String? @map("imagen_portada")
  imagenPortadaPublicId String? @map("imagen_portada_public_id")

  productos Producto[]

  @@map("categorias")
}

// Tallas son un catálogo reutilizable (ej: "7", "8.5", "S", "M", "38")
// El campo `tipo` permite agrupar (calzado, ropa, accesorio) para no mezclar
// tallas de zapato con tallas de playera en el mismo selector.
model Talla {
  id       Int               @id @default(autoincrement())
  valor    String
  tipo     String            // "calzado" | "ropa" | "accesorio" | ...
  orden    Int               @default(0)
  activo   Boolean           @default(true)
  variantes ProductoVariante[]

  @@unique([valor, tipo])
  @@map("tallas")
}

// ---------------------------------------------------------------------------
// Productos y variantes (una variante = combinación talla/color con stock propio)
// ---------------------------------------------------------------------------

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  marcaId      Int      @map("marca_id")
  marca        Marca    @relation(fields: [marcaId], references: [id])
  modeloId     Int?     @map("modelo_id")
  modelo       Modelo?  @relation(fields: [modeloId], references: [id])
  categoriaId  Int      @map("categoria_id")
  categoria    Categoria @relation(fields: [categoriaId], references: [id])
  precioCompra Decimal  @default(0) @map("precio_compra") @db.Decimal(10, 2)
  precioVenta  Decimal  @default(0) @map("precio_venta") @db.Decimal(10, 2)
  activo       Boolean  @default(true)

  // Campos personalizados definidos dinámicamente por el rol DESARROLLO
  // sin necesidad de migraciones (ver modelo CampoPersonalizado).
  atributosExtra Json?  @default("{}") @map("atributos_extra")

  variantes    ProductoVariante[]
  imagenes     ProductoImagen[]
  // Cupones de la tienda en línea que incluyen este producto en su lista de
  // productos aplicables (ver modelo Cupon: un cupón de código solo
  // descuenta los renglones del carrito que estén en esta lista).
  cupones      CuponProducto[]
  favoritosDe  ClienteFavorito[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("productos")
}

// Fotos del producto (no de la variante: la misma foto sirve para todas las
// tallas/colores). Se guardan en Cloudinary; aquí solo vive la URL y el
// public_id necesario para poder borrarlas allá también.
model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  url         String
  publicId    String   @map("public_id")
  esPrincipal Boolean  @default(false) @map("es_principal")
  orden       Int      @default(0)
  // Color de variante al que pertenece esta foto (ej. modelos "By You"
  // custom donde el mismo producto tiene colores muy distintos entre sí).
  // null = foto general del producto, válida para cualquier color que no
  // tenga una foto propia — ver docs/ARQUITECTURA.md.
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("producto_imagenes")
}

model ProductoVariante {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  producto      Producto @relation(fields: [productoId], references: [id])
  tallaId       Int?     @map("talla_id")
  talla         Talla?   @relation(fields: [tallaId], references: [id])
  color         String?
  // Código de fábrica/proveedor tal cual viene en el producto — en calzado
  // suele venir por LOTE de tallas (ej. un mismo SKU cubre 23-25.5 cm y otro
  // cubre 26-32 cm), así que el mismo texto se repite legítimamente entre
  // varias variantes/tallas del mismo producto. NO es único: la variante ya
  // se identifica de forma única por su id/codigoInterno, no por este campo.
  sku           String
  // Código propio del sistema, único de verdad, generado automáticamente al
  // crear la variante (ver utils/codigoInterno.js) a partir de sku+talla+
  // color con un sufijo si llegara a colisionar. Una vez asignado no cambia
  // aunque después se edite el sku/talla — sirve para trazabilidad interna y
  // para etiquetar/escanear cada talla por separado si hace falta.
  codigoInterno String   @unique @map("codigo_interno")
  activo        Boolean  @default(true)

  // El stock ya no vive aquí: cada variante puede tener stock distinto en
  // cada sucursal (ver modelo Existencia).
  existencias   Existencia[]
  movimientos   MovimientoInventario[]
  ventaItems    VentaItem[]
  transferencias TransferenciaInventario[]
  apartadoItems ApartadoItem[]
  pedidoItems   PedidoItem[]

  // Proveedor principal de este SKU específico (una talla/color puede venir
  // de un proveedor distinto al de otra talla del mismo producto). Es el
  // proveedor "por defecto" para clasificar/reportar; el proveedor real de
  // cada reabasto puntual se registra en MovimientoInventario.proveedorId
  // por si un mismo número a veces lo surte uno u otro.
  proveedorId   Int?       @map("proveedor_id")
  proveedor     Proveedor? @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, tallaId, color])
  @@map("producto_variantes")
}

// ---------------------------------------------------------------------------
// Inventario: historial de movimientos (entradas, salidas, ajustes)
// ---------------------------------------------------------------------------

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  DEVOLUCION
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  APARTADO
  PEDIDO_ONLINE
}

model MovimientoInventario {
  id          Int              @id @default(autoincrement())
  sucursalId  Int              @map("sucursal_id")
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id])
  varianteId  Int              @map("variante_id")
  variante    ProductoVariante @relation(fields: [varianteId], references: [id])
  tipo        TipoMovimiento
  cantidad    Int              // positivo o negativo según tipo
  motivo      String?

  // Opcional: los movimientos generados por un pedido en línea no los hace
  // ningún empleado (el cliente arma su propio pedido), así que aquí no hay
  // usuario interno que registrar.
  usuarioId   Int?             @map("usuario_id")
  usuario     Usuario?         @relation(fields: [usuarioId], references: [id])

  // Si el movimiento vino de una transferencia entre sucursales
  transferenciaId Int?         @map("transferencia_id")
  transferencia   TransferenciaInventario? @relation(fields: [transferenciaId], references: [id])

  // Si el movimiento vino de un pedido de la tienda en línea
  pedidoId    Int?             @map("pedido_id")
  pedido      Pedido?          @relation(fields: [pedidoId], references: [id])

  // De qué proveedor vino este lote (normalmente solo se llena en
  // movimientos tipo ENTRADA). Permite saber exactamente quién surtió cada
  // reabasto, incluso si en otra ocasión el mismo número lo surtió alguien
  // más — no depende únicamente del proveedor "por defecto" de la variante.
  proveedorId Int?             @map("proveedor_id")
  proveedor   Proveedor?       @relation(fields: [proveedorId], references: [id])

  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("movimientos_inventario")
}

// ---------------------------------------------------------------------------
// Transferencias de mercancía entre sucursales
// ---------------------------------------------------------------------------

enum EstadoTransferencia {
  SOLICITADA  // creada, stock ya descontado del origen, en camino
  RECIBIDA    // confirmada en destino, stock ya sumado al destino
  CANCELADA   // cancelada antes de recibirse, stock devuelto al origen
}

model TransferenciaInventario {
  id                Int      @id @default(autoincrement())
  folio             String   @unique
  varianteId        Int      @map("variante_id")
  variante          ProductoVariante @relation(fields: [varianteId], references: [id])
  // De qué bucket de proveedor sale el stock en el origen; llega al mismo
  // proveedor en el destino (una transferencia no cambia quién surtió la
  // mercancía, solo la mueve de sucursal).
  proveedorId       Int?     @map("proveedor_id")
  proveedor         Proveedor? @relation(fields: [proveedorId], references: [id])
  cantidad          Int
  sucursalOrigenId  Int      @map("sucursal_origen_id")
  sucursalOrigen    Sucursal @relation("TransferenciaOrigen", fields: [sucursalOrigenId], references: [id])
  sucursalDestinoId Int      @map("sucursal_destino_id")
  sucursalDestino   Sucursal @relation("TransferenciaDestino", fields: [sucursalDestinoId], references: [id])
  estado            EstadoTransferencia @default(SOLICITADA)
  solicitadoPorId   Int      @map("solicitado_por_id")
  solicitadoPor     Usuario  @relation("TransferenciasSolicitadas", fields: [solicitadoPorId], references: [id])
  recibidoPorId     Int?     @map("recibido_por_id")
  recibidoPor       Usuario? @relation("TransferenciasRecibidas", fields: [recibidoPorId], references: [id])
  notas             String?
  createdAt         DateTime @default(now()) @map("created_at")
  recibidoAt        DateTime? @map("recibido_at")

  movimientos       MovimientoInventario[]
  notificaciones    Notificacion[]

  @@map("transferencias_inventario")
}

// Notificaciones dentro del sistema (sin correo/SMS por ahora — ver
// docs/ARQUITECTURA.md). Un renglón por destinatario: si un evento le
// interesa a 3 personas, se crean 3 notificaciones, una por usuario, cada
// una con su propio estado de "leída" independiente del resto.
//
// Las genera: 1) una transferencia entre sucursales (INVENTARIO/ADMIN), y
// 2) un apartado cuyo stock se reserva en una sucursal distinta a la que
// atiende al cliente (ver POST /apartados) — la sucursal que "presta" el
// producto necesita saber que se le apartó. El campo `tipo` es texto libre a
// propósito para poder sumar más eventos a futuro sin necesitar una
// migración nueva.
model Notificacion {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @map("usuario_id")
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  tipo            String
  titulo          String
  mensaje         String
  leida           Boolean  @default(false)

  // Referencia opcional a la transferencia o al apartado relacionado, para
  // poder armar un enlace directo desde la notificación (a lo más una de
  // las dos aplica según el tipo de evento).
  transferenciaId Int?     @map("transferencia_id")
  transferencia   TransferenciaInventario? @relation(fields: [transferenciaId], references: [id])
  apartadoId      Int?     @map("apartado_id")
  apartado        Apartado? @relation(fields: [apartadoId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")

  @@map("notificaciones")
}

// ---------------------------------------------------------------------------
// Pagos: método de pago y cuentas donde se reciben transferencias
// ---------------------------------------------------------------------------

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// Catálogo de cuentas bancarias propias donde se reciben transferencias
// (ej. "BBVA Tienda", "Santander Sucursal Centro"). Es del negocio en
// general, no de una sucursal en particular, porque normalmente unas pocas
// cuentas se comparten entre todas las sucursales.
model CuentaTransferencia {
  id           Int      @id @default(autoincrement())
  nombre       String   // etiqueta visible, ej. "BBVA Tienda"
  banco        String?
  titular      String?
  numeroCuenta String?  @map("numero_cuenta") // CLABE o número de cuenta/tarjeta
  activo       Boolean  @default(true)

  // Si es true, esta cuenta se muestra a los clientes de la tienda en línea
  // como destino del SPEI al hacer checkout (ver Pedido). Puede haber varias
  // cuentas activas de uso interno que no se quieran exponer al público.
  paraVentasOnline Boolean @default(false) @map("para_ventas_online")

  createdAt    DateTime @default(now()) @map("created_at")

  ventas       Venta[]
  pagosApartado ApartadoPago[]
  pedidos      Pedido[]

  @@map("cuentas_transferencia")
}

// ---------------------------------------------------------------------------
// Proveedores: quién surte la mercancía y los pagos que se les hacen
// ---------------------------------------------------------------------------
//
// Por ahora son solo unos cuantos proveedores y entre todos surten todo el
// catálogo. Un mismo producto puede venir de distintos proveedores según la
// talla/color (a veces hasta el mismo número lo surte uno u otro en
// ocasiones distintas), por eso el proveedor se registra en dos niveles:
//  - ProductoVariante.proveedorId: proveedor "por defecto" de ese SKU, para
//    clasificar/filtrar el catálogo y reportar qué se vende de quién.
//  - MovimientoInventario.proveedorId: proveedor real de cada reabasto
//    puntual (solo en movimientos ENTRADA), para no perder el dato si un
//    número específico se surtió de alguien distinto al proveedor de la
//    variante en esa ocasión.
model Proveedor {
  id           Int      @id @default(autoincrement())
  nombre       String
  contacto     String?  // nombre de la persona con la que se trata
  telefono     String?

  // Cuenta bancaria DEL proveedor (a dónde se le transfiere para pagarle).
  // Es la cuenta de destino de los PagoProveedor por transferencia.
  banco        String?
  titular      String?
  numeroCuenta String?  @map("numero_cuenta")

  notas        String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  variantes    ProductoVariante[]
  movimientos  MovimientoInventario[]
  existencias  Existencia[]
  ventaItems   VentaItem[]
  apartadoItems ApartadoItem[]
  pedidoItems  PedidoItem[]
  transferencias TransferenciaInventario[]
  pagos        PagoProveedor[]
  // Pedidos en línea donde un empleado confirmó que la transferencia llegó
  // a la cuenta de ESTE proveedor (no a la cuenta de la tienda).
  pedidosPagoConfirmado Pedido[] @relation("PedidosConfirmadosProveedor")

  @@map("proveedores")
}

// Pagos que el negocio le hace a un proveedor (dinero que sale, a
// diferencia de Venta/ApartadoPago que es dinero que entra). No se liga a
// movimientos de inventario específicos (no se maneja conciliación por
// factura en v1): es un registro simple de cuánto y cómo se le ha pagado a
// cada proveedor, con comprobante si fue por transferencia.
model PagoProveedor {
  id                  Int        @id @default(autoincrement())
  proveedorId         Int        @map("proveedor_id")
  proveedor           Proveedor  @relation(fields: [proveedorId], references: [id])

  monto               Decimal    @db.Decimal(10, 2)
  metodoPago          MetodoPago @default(EFECTIVO) @map("metodo_pago")
  comprobanteUrl       String?   @map("comprobante_url")
  comprobantePublicId  String?   @map("comprobante_public_id")
  concepto             String?   // ej. "Reabasto de tenis, pedido de agosto"

  registradoPorId      Int       @map("registrado_por_id")
  registradoPor        Usuario   @relation("PagosProveedorRegistrados", fields: [registradoPorId], references: [id])

  createdAt             DateTime @default(now()) @map("created_at")

  @@map("pagos_proveedor")
}

// ---------------------------------------------------------------------------
// Solicitudes de permiso: el rol INVENTARIO no puede desactivar catálogos
// (marca/categoría/modelo/talla) ni editar o desactivar proveedores por su
// cuenta — esas acciones quedan "en espera" aquí hasta que ADMIN_PRINCIPAL o
// DESARROLLO las aprueben (y entonces sí se aplican) o las rechacen. Ver
// routes/solicitudes.js y el helper crearSolicitudOAplicar en
// routes/catalogos.js / routes/proveedores.js.
// ---------------------------------------------------------------------------

enum TipoSolicitud {
  MARCA
  CATEGORIA
  MODELO
  TALLA
  PROVEEDOR
}

enum AccionSolicitud {
  EDITAR
  DESACTIVAR
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model SolicitudPermiso {
  id             Int             @id @default(autoincrement())
  tipo           TipoSolicitud
  accion         AccionSolicitud
  entidadId      Int             @map("entidad_id")
  // Copia del nombre al momento de solicitar, para poder mostrarlo en la
  // bandeja de solicitudes aunque el registro original cambie después.
  entidadNombre  String?         @map("entidad_nombre")
  // Para accion=EDITAR: los campos propuestos, tal cual se aplicarían con
  // prisma.<modelo>.update({ data: datosCambio }) al aprobarse.
  datosCambio    Json?           @map("datos_cambio")
  motivo         String?

  estado         EstadoSolicitud @default(PENDIENTE)

  solicitadoPorId Int      @map("solicitado_por_id")
  solicitadoPor   Usuario  @relation("SolicitudesCreadas", fields: [solicitadoPorId], references: [id])
  solicitadoAt    DateTime @default(now()) @map("solicitado_at")

  revisadoPorId   Int?      @map("revisado_por_id")
  revisadoPor     Usuario?  @relation("SolicitudesRevisadas", fields: [revisadoPorId], references: [id])
  revisadoAt      DateTime? @map("revisado_at")
  notaRevision    String?   @map("nota_revision")

  @@map("solicitudes_permiso")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  PENDIENTE
}

model Venta {
  id          Int         @id @default(autoincrement())
  folio       String      @unique
  sucursalId  Int         @map("sucursal_id")
  sucursal    Sucursal    @relation(fields: [sucursalId], references: [id])
  usuarioId   Int         @map("usuario_id")
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  cliente     String?
  // Teléfono del cliente capturado en el punto de venta (tiendas físicas),
  // para mandarle el ticket digital por WhatsApp al momento de la compra.
  // Opcional: sigue siendo válido registrar una venta de mostrador sin
  // captar el teléfono.
  clienteTelefono String? @map("cliente_telefono")
  // PDF del ticket digital (generado con pdfkit, subido a Cloudinary — ver
  // utils/ticketPdf.js). Se guarda para poder reabrirlo/reenviarlo después
  // desde el historial, sin tener que regenerarlo.
  ticketPdfUrl      String? @map("ticket_pdf_url")
  ticketPdfPublicId String? @map("ticket_pdf_public_id")
  total       Decimal     @default(0) @db.Decimal(10, 2)

  // Descuento libre (% o $) que el vendedor captura al registrar la venta en
  // el punto de venta de una sucursal — a diferencia de los cupones de la
  // tienda en línea, aquí no hay código: es una cifra que el cajero teclea
  // directamente, con un motivo opcional para dejar rastro de por qué se
  // autorizó (ver POST /ventas). descuentoMonto es el monto real en pesos ya
  // calculado y aplicado al total (nunca puede exceder la suma de los
  // artículos); descuentoValor es lo que el cajero tecleó tal cual (el % o
  // el monto, según descuentoTipo), solo para referencia/edición futura.
  descuentoTipo   TipoDescuento? @map("descuento_tipo")
  descuentoValor  Decimal?       @map("descuento_valor") @db.Decimal(10, 2)
  descuentoMonto  Decimal        @default(0) @map("descuento_monto") @db.Decimal(10, 2)
  descuentoMotivo String?        @map("descuento_motivo")

  // Efectivo que el cliente entregó, solo cuando metodoPago = EFECTIVO — se
  // guarda para poder mostrar "cambio dado" en el ticket digital (el cambio
  // se calcula como efectivoRecibido - total, no se guarda aparte).
  efectivoRecibido Decimal? @map("efectivo_recibido") @db.Decimal(10, 2)

  metodoPago  MetodoPago  @default(EFECTIVO) @map("metodo_pago")
  // Solo aplica cuando metodoPago = TRANSFERENCIA
  cuentaTransferenciaId Int? @map("cuenta_transferencia_id")
  cuentaTransferencia   CuentaTransferencia? @relation(fields: [cuentaTransferenciaId], references: [id])
  comprobanteUrl        String? @map("comprobante_url")
  comprobantePublicId   String? @map("comprobante_public_id")

  estado      EstadoVenta @default(COMPLETADA)
  items       VentaItem[]
  // Historial de correcciones hechas por un administrador después de
  // registrada (ver PATCH /ventas/:id/editar) — ej. se vendió con el
  // proveedor equivocado, se corrigió el método de pago, etc. Cada fila es
  // una edición con su motivo, quién la hizo y un snapshot de qué cambió.
  ediciones   VentaEdicion[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("ventas")
}

model VentaItem {
  id             Int              @id @default(autoincrement())
  ventaId        Int              @map("venta_id")
  venta          Venta            @relation(fields: [ventaId], references: [id])
  // Nulo cuando el renglón es un producto NO registrado en el catálogo (ver
  // descripcionLibre abajo) — en ese caso no hay ProductoVariante ni
  // Existencia de por medio, así que la venta no descuenta inventario. Un
  // VentaItem siempre trae exactamente uno de los dos (varianteId XOR
  // descripcionLibre), reforzado también a nivel de base de datos con un
  // CHECK constraint (ver migración 20260901100000_venta_items_libres).
  varianteId     Int?              @map("variante_id")
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id])
  // Descripción capturada a mano por el cajero para un artículo que no está
  // dado de alta en el sistema (ej. algo de otra marca que se vende una sola
  // vez). Solo aplica cuando varianteId es null.
  descripcionLibre String?        @map("descripcion_libre")
  // De qué bucket de proveedor salió el stock vendido (null = renglón sin
  // clasificar). Se necesita para poder regresar el stock al bucket correcto
  // si la venta se cancela. En un renglón libre este campo es solo
  // informativo (de qué proveedor vino la mercancía) — no existe ningún
  // bucket de Existencia que ajustar.
  proveedorId    Int?             @map("proveedor_id")
  proveedor      Proveedor?       @relation(fields: [proveedorId], references: [id])
  cantidad       Int
  precioUnitario Decimal          @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal          @db.Decimal(10, 2)

  @@map("venta_items")
}

// Auditoría de una corrección hecha por un administrador a una venta ya
// registrada (ver PATCH /ventas/:id/editar) — por ejemplo, corregir el
// proveedor de un artículo mal registrado, el método de pago, o un
// descuento. "motivo" es obligatorio (por qué se corrigió) y "cambios"
// guarda un snapshot JSON de los campos que cambiaron, antes/después, tanto
// a nivel de la venta como de cada renglón afectado — así queda un rastro
// completo sin depender de reconstruirlo a partir de otras tablas.
model VentaEdicion {
  id        Int      @id @default(autoincrement())
  ventaId   Int      @map("venta_id")
  venta     Venta    @relation(fields: [ventaId], references: [id])
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  motivo    String
  cambios   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("venta_ediciones")
}

// ---------------------------------------------------------------------------
// Campos personalizados (para que el rol DESARROLLO agregue campos a futuro
// sin tocar código): describe qué campos extra existen para cada entidad y
// cómo debe renderizarlos el frontend. Los valores reales viven en el JSON
// `atributosExtra` de cada registro.
// ---------------------------------------------------------------------------

enum TipoCampo {
  TEXTO
  NUMERO
  BOOLEANO
  FECHA
  SELECT
}

model CampoPersonalizado {
  id          Int       @id @default(autoincrement())
  entidad     String    // "producto" | "producto_variante" | ...
  clave       String    // nombre interno del campo, ej: "genero"
  etiqueta    String    // texto visible, ej: "Género"
  tipo        TipoCampo
  opciones    Json?     // para SELECT: ["Hombre","Mujer","Unisex"]
  requerido   Boolean   @default(false)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([entidad, clave])
  @@map("campos_personalizados")
}

// ---------------------------------------------------------------------------
// Clientes y apartados (layaway)
// ---------------------------------------------------------------------------

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String   @unique // clave natural para buscar/evitar duplicar clientes
  email     String?
  notas     String?

  // Cuenta de la tienda en línea: un Cliente puede existir solo como
  // registro interno (dado de alta por staff en un apartado, sin password)
  // o también tener cuenta propia para comprar en línea (con password). No
  // hay una unicidad de email a nivel de base de datos porque registros
  // viejos creados por staff pueden repetir/omitir email; la unicidad para
  // efectos de login se valida en el endpoint de registro (ver
  // routes/tienda/auth.js) contra clientes que YA tengan passwordHash.
  passwordHash String? @map("password_hash")
  activo       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  apartados Apartado[]
  pedidos   Pedido[]
  cuponUsos CuponUso[]
  resetTokens ClienteResetToken[]
  favoritos ClienteFavorito[]

  @@map("clientes")
}

// Tokens de un solo uso para "olvidé mi contraseña" (ver
// routes/tienda/auth.js). Se guarda el hash del token, nunca el token en
// claro — igual que con las contraseñas — para que una fuga de la base de
// datos no permita restablecer cuentas directamente.
model ClienteResetToken {
  id        Int       @id @default(autoincrement())
  clienteId Int       @map("cliente_id")
  cliente   Cliente   @relation(fields: [clienteId], references: [id])
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("cliente_reset_tokens")
}

// Productos que un cliente marcó como favorito en la tienda en línea (el
// corazón en la tarjeta de producto). Una fila por par cliente/producto —
// @@unique evita duplicados si el cliente le da clic dos veces (doble tap,
// red lenta, etc.).
model ClienteFavorito {
  id         Int      @id @default(autoincrement())
  clienteId  Int      @map("cliente_id")
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([clienteId, productoId])
  @@map("cliente_favoritos")
}

enum EstadoApartado {
  ACTIVO     // tiene saldo pendiente, stock ya reservado
  LIQUIDADO  // ya se pagó completo (pendiente de entregar o ya entregado)
  CANCELADO  // se canceló, stock devuelto a la sucursal de origen
}

// Un apartado puede incluir varios productos (ApartadoItem), cada uno
// reservado desde la sucursal donde físicamente está ese stock — no
// necesariamente la misma sucursal donde el cliente está apartando.
model Apartado {
  id              Int            @id @default(autoincrement())
  folio           String         @unique
  clienteId       Int            @map("cliente_id")
  cliente         Cliente        @relation(fields: [clienteId], references: [id])

  // Sucursal/vendedor que atiende al cliente y hace el apartado (no
  // necesariamente donde está el stock de cada artículo, ver ApartadoItem).
  sucursalVentaId Int            @map("sucursal_venta_id")
  sucursalVenta   Sucursal       @relation("ApartadoVenta", fields: [sucursalVentaId], references: [id])

  total           Decimal        @default(0) @db.Decimal(10, 2)
  estado          EstadoApartado @default(ACTIVO)
  fechaLimite     DateTime?      @map("fecha_limite")
  notas           String?

  // Comprobante en PDF (creación o del abono más reciente), generado con
  // pdfkit y subido a Cloudinary — ver utils/apartadoPdf.js. Se guarda para
  // poder reabrirlo/reenviarlo después sin regenerarlo.
  ticketPdfUrl      String? @map("ticket_pdf_url")
  ticketPdfPublicId String? @map("ticket_pdf_public_id")

  creadoPorId     Int            @map("creado_por_id")
  creadoPor       Usuario        @relation("ApartadosCreados", fields: [creadoPorId], references: [id])

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  items           ApartadoItem[]
  pagos           ApartadoPago[]
  notificaciones  Notificacion[]

  @@map("apartados")
}

model ApartadoItem {
  id              Int              @id @default(autoincrement())
  apartadoId      Int              @map("apartado_id")
  apartado        Apartado         @relation(fields: [apartadoId], references: [id])
  varianteId      Int              @map("variante_id")
  variante        ProductoVariante @relation(fields: [varianteId], references: [id])

  // Sucursal de donde se descontó el stock al crear el apartado.
  sucursalStockId Int              @map("sucursal_stock_id")
  sucursalStock   Sucursal         @relation("ApartadoStock", fields: [sucursalStockId], references: [id])

  // De qué bucket de proveedor se reservó el stock (null = sin clasificar).
  // Necesario para regresarlo al bucket correcto si el apartado se cancela.
  proveedorId     Int?             @map("proveedor_id")
  proveedor       Proveedor?       @relation(fields: [proveedorId], references: [id])

  cantidad        Int
  precioUnitario  Decimal          @map("precio_unitario") @db.Decimal(10, 2)
  subtotal        Decimal          @db.Decimal(10, 2)

  @@map("apartado_items")
}

// Abonos del cliente hacia un apartado. saldo pendiente = apartado.total -
// suma(monto) de estos pagos — se calcula al vuelo, no se guarda cacheado.
model ApartadoPago {
  id                    Int      @id @default(autoincrement())
  apartadoId            Int      @map("apartado_id")
  apartado              Apartado @relation(fields: [apartadoId], references: [id])
  monto                 Decimal  @db.Decimal(10, 2)

  metodoPago            MetodoPago @default(EFECTIVO) @map("metodo_pago")
  cuentaTransferenciaId Int?     @map("cuenta_transferencia_id")
  cuentaTransferencia   CuentaTransferencia? @relation(fields: [cuentaTransferenciaId], references: [id])
  comprobanteUrl        String?  @map("comprobante_url")
  comprobantePublicId   String?  @map("comprobante_public_id")

  registradoPorId       Int      @map("registrado_por_id")
  registradoPor         Usuario  @relation("PagosApartadoRegistrados", fields: [registradoPorId], references: [id])

  createdAt             DateTime @default(now()) @map("created_at")

  @@map("apartado_pagos")
}

// ---------------------------------------------------------------------------
// Tienda en línea: pedidos de clientes con cuenta propia
// ---------------------------------------------------------------------------
//
// A diferencia de una Venta (mostrador) o un Apartado (layaway con abonos),
// un Pedido es de pago único hecho por el cliente sin intervención de un
// vendedor: elige productos, paga por SPEI a una cuenta del negocio y sube su
// comprobante. El pago se valida a mano (v1: no hay integración bancaria
// automática) y luego el pedido sigue su ciclo de envío/entrega.
//
// Reserva de stock: igual que en Apartado, el stock se descuenta de
// inmediato al crear el pedido (así dos clientes no pueden "comprar" la
// misma última pieza mientras uno de los dos nunca paga). A diferencia de
// Apartado, aquí el cliente no elige la sucursal: el backend busca
// automáticamente una sucursal con stock suficiente para cada artículo
// (prefiriendo la bodega central) y la guarda en
// PedidoItem.sucursalStockId. Si el pedido se cancela antes de pagarse, el
// stock regresa a esa misma sucursal.
//
// origen distingue un Pedido armado por el cliente mismo en el checkout de
// la tienda (TIENDA_ONLINE, el caso de arriba) de uno que un vendedor
// captura a mano porque el cliente hizo su pedido por otro canal (WhatsApp,
// Instagram, etc. — ver POST /pedidos-online en routes/pedidosOnline.js).
// Se reutiliza este mismo modelo en vez de crear una tabla aparte porque la
// parte difícil (dirección de envío, reserva de stock, ciclo de estados,
// PDF/paquetería) es idéntica; lo único que cambia es quién lo captura y
// que el método de pago ya no es forzosamente SPEI (ver metodoPago). Un
// pedido manual sí permite que el vendedor elija de qué sucursal sale cada
// artículo (igual que Apartado), a diferencia del armado automático que
// usa la tienda en línea.
enum OrigenPedido {
  TIENDA_ONLINE // el cliente lo armó solo desde el checkout de la tienda
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TELEFONO
  OTRO
}

enum EstadoPedido {
  PENDIENTE_PAGO // creado, stock reservado, esperando que el cliente suba su comprobante
  EN_VALIDACION  // el cliente ya subió comprobante, un empleado debe revisarlo
  PAGADO         // un empleado confirmó que el pago llegó
  ENVIADO        // el pedido ya salió del negocio hacia el cliente
  RECIBIDO       // el cliente (o un empleado) confirmó que ya llegó
  CANCELADO      // cancelado antes de pagarse; el stock se devolvió
}

model Pedido {
  id        Int          @id @default(autoincrement())
  folio     String       @unique
  clienteId Int          @map("cliente_id")
  cliente   Cliente      @relation(fields: [clienteId], references: [id])

  estado    EstadoPedido @default(PENDIENTE_PAGO)

  // Por qué canal llegó este pedido (ver enum OrigenPedido arriba) y, si un
  // vendedor lo capturó a mano, quién fue (null = lo armó el cliente mismo
  // desde el checkout de la tienda en línea). ROLES_PEDIDOS_MANUAL en
  // routes/pedidosOnline.js usa origen para decidir qué puede ver/operar
  // el rol VENTAS: todo lo que no sea TIENDA_ONLINE.
  origen     OrigenPedido @default(TIENDA_ONLINE)
  creadoPorId Int?    @map("creado_por_id")
  creadoPor   Usuario? @relation("PedidosCreadosManualmente", fields: [creadoPorId], references: [id])

  // total = suma de los artículos (PedidoItem.subtotal) + costoEnvio -
  // cuponDescuento - descuentoManualMonto. costoEnvio se "congela" al crear
  // el pedido (copiado de ConfiguracionTienda) para que si el negocio cambia
  // la tarifa después, los pedidos ya hechos conserven el costo con el que
  // realmente se cobraron — por ahora es un monto fijo global; en el futuro
  // se piensa volver dinámico (por zona/peso/etc.).
  total      Decimal @default(0) @db.Decimal(10, 2)
  costoEnvio Decimal @default(0) @db.Decimal(10, 2) @map("costo_envio")

  // Cupón de código aplicado por el cliente al armar el pedido (ver POST
  // /tienda/pedidos y utils/cupones.js). cuponCodigo queda "congelado" tal
  // cual se usó, para poder mostrarlo aunque el cupón se edite/borre después.
  cuponId        Int?     @map("cupon_id")
  cupon          Cupon?   @relation(fields: [cuponId], references: [id])
  cuponCodigo    String?  @map("cupon_codigo")
  cuponDescuento Decimal  @default(0) @map("cupon_descuento") @db.Decimal(10, 2)
  cuponUso       CuponUso?

  // Descuento manual que el negocio activa DESPUÉS de creado el pedido,
  // mientras sigue PENDIENTE_PAGO — típicamente porque un modelo en
  // particular admite descuento y se le confirma al cliente por WhatsApp
  // antes de que haga la transferencia (ver POST
  // /pedidos-online/:id/aplicar-descuento). descuentoConfirmadoWhatsapp es
  // solo un registro informativo de que ya se avisó al cliente por chat; no
  // cambia montos por sí solo.
  descuentoManualTipo        TipoDescuento? @map("descuento_manual_tipo")
  descuentoManualValor       Decimal?       @map("descuento_manual_valor") @db.Decimal(10, 2)
  descuentoManualMonto       Decimal        @default(0) @map("descuento_manual_monto") @db.Decimal(10, 2)
  descuentoManualNotas       String?        @map("descuento_manual_notas")
  descuentoConfirmadoWhatsapp Boolean       @default(false) @map("descuento_confirmado_whatsapp")
  descuentoAplicadoPorId     Int?           @map("descuento_aplicado_por_id")
  descuentoAplicadoPor       Usuario?       @relation("PedidosDescuentoAplicado", fields: [descuentoAplicadoPorId], references: [id])
  descuentoAplicadoAt        DateTime?      @map("descuento_aplicado_at")

  // Dirección de envío: se guarda "congelada" en el pedido (no como
  // referencia a un catálogo de direcciones del cliente) para que, si el
  // cliente cambia sus datos después, los pedidos ya hechos conserven la
  // dirección con la que realmente se enviaron.
  destinatario     String
  telefonoContacto String  @map("telefono_contacto")
  calle            String
  numeroExt        String  @map("numero_ext")
  numeroInt        String? @map("numero_int")
  colonia          String
  municipio        String
  estadoMx         String  @map("estado_mx")
  codigoPostal     String  @map("codigo_postal")
  referencias      String?

  // Cómo se cobró/cobrará este pedido. Los pedidos de la tienda en línea
  // (origen TIENDA_ONLINE) siempre son TRANSFERENCIA (único método que
  // ofrece el checkout, ver arriba); un pedido manual puede ser efectivo o
  // tarjeta también, típicamente cobrado en persona o ya confirmado por el
  // vendedor antes de capturarlo (ver POST /pedidos-online/:id/marcar-pagado
  // en routes/pedidosOnline.js). agruparPorMetodoPago en reportes.js usa
  // este campo (junto con origen) para no meter todo bajo "Pedidos en
  // línea" cuando en realidad fue efectivo/tarjeta de un pedido manual.
  metodoPago MetodoPago @default(TRANSFERENCIA) @map("metodo_pago")

  // Pago por transferencia SPEI: cuenta que se le mostró al cliente y
  // referencia que se le pidió poner en el concepto, para poder ubicar el
  // pago manualmente entre los movimientos bancarios reales. Solo aplica
  // cuando metodoPago = TRANSFERENCIA; en un pedido manual pagado en
  // efectivo/tarjeta, cuentaTransferenciaId queda nulo.
  cuentaTransferenciaId Int?                 @map("cuenta_transferencia_id")
  cuentaTransferencia   CuentaTransferencia? @relation(fields: [cuentaTransferenciaId], references: [id])
  referenciaPago        String               @map("referencia_pago")

  comprobanteUrl             String?   @map("comprobante_url")
  comprobantePublicId        String?   @map("comprobante_public_id")
  comprobanteSubidoAt        DateTime? @map("comprobante_subido_at")
  // Motivo si un empleado rechaza el comprobante y el pedido regresa a
  // PENDIENTE_PAGO para que el cliente vuelva a intentar.
  comprobanteRechazadoMotivo String?   @map("comprobante_rechazado_motivo")

  validadoPorId Int?      @map("validado_por_id")
  validadoPor   Usuario?  @relation("PedidosValidados", fields: [validadoPorId], references: [id])
  validadoAt    DateTime? @map("validado_at")

  // A qué cuenta llegó realmente la transferencia, confirmado por el
  // empleado al validar el pago (ver POST /pedidos-online/:id/validar-pago).
  // Null = la cuenta de la tienda (cuentaTransferenciaId, arriba); si se
  // elige un proveedor es porque el cliente le transfirió directo a él
  // (flujo típico: el proveedor le pasa sus datos de pago por WhatsApp).
  proveedorPagoConfirmadoId Int?       @map("proveedor_pago_confirmado_id")
  proveedorPagoConfirmado   Proveedor? @relation("PedidosConfirmadosProveedor", fields: [proveedorPagoConfirmadoId], references: [id])

  paqueteria String?
  numeroGuia String?   @map("numero_guia")
  enviadoAt  DateTime? @map("enviado_at")
  recibidoAt DateTime? @map("recibido_at")

  notas String?

  items       PedidoItem[]
  movimientos MovimientoInventario[]
  // Calificación que deja el cliente una vez RECIBIDO (ver PedidoResena).
  // Uno por pedido: se califica la experiencia completa, no cada artículo.
  resena      PedidoResena?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pedidos")
}

model PedidoItem {
  id              Int              @id @default(autoincrement())
  pedidoId        Int              @map("pedido_id")
  pedido          Pedido           @relation(fields: [pedidoId], references: [id])
  varianteId      Int              @map("variante_id")
  variante        ProductoVariante @relation(fields: [varianteId], references: [id])

  // Sucursal de donde se descontó el stock (elegida automáticamente al
  // crear el pedido, ver comentario arriba del modelo Pedido).
  sucursalStockId Int              @map("sucursal_stock_id")
  sucursalStock   Sucursal         @relation("PedidoStock", fields: [sucursalStockId], references: [id])

  // De qué bucket de proveedor se descontó el stock. Aquí no hay un cajero
  // eligiendo (es el cliente comprando solo en la tienda en línea), así que
  // se asigna con una regla automática al crear el pedido (ver
  // routes/tienda/pedidos.js). Ya no decide a qué número se manda el pedido
  // por WhatsApp: todos los pedidos en línea usan siempre el WhatsApp
  // principal de la tienda (ver ConfiguracionTienda.whatsappTienda), sin
  // importar el proveedor de cada renglón.
  proveedorId    Int?             @map("proveedor_id")
  proveedor      Proveedor?       @relation(fields: [proveedorId], references: [id])

  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  @@map("pedido_items")
}

// ---------------------------------------------------------------------------
// Cupones y descuentos
// ---------------------------------------------------------------------------
//
// Un Cupon es un código que el cliente teclea en el checkout de la tienda en
// línea (ver POST /tienda/cupones/validar y POST /tienda/pedidos). A
// diferencia de un descuento general de catálogo, un cupón SOLO aplica a los
// productos específicos que el admin eligió (CuponProducto) — si el carrito
// trae otros productos no listados, esos renglones no se descuentan; si
// ninguno de los productos del carrito está en la lista, el cupón se
// rechaza. Es distinto del descuento libre que un vendedor captura en el
// punto de venta de una sucursal (Venta.descuentoTipo/Valor/Monto, sin
// código) y del descuento manual post-pedido (Pedido.descuentoManualTipo/
// Valor/Monto, ver comentario en el modelo Pedido).
enum TipoDescuento {
  PORCENTAJE // Cupon.valor / Venta.descuentoValor / Pedido.descuentoManualValor es un % (0-100)
  MONTO      // es un monto fijo en pesos
}

model Cupon {
  id            Int           @id @default(autoincrement())
  // Se guarda siempre en mayúsculas (ver utils/cupones.js) para que el
  // cliente pueda escribirlo en cualquier combinación de mayúsculas/
  // minúsculas al usarlo.
  codigo        String        @unique
  descripcion   String?
  tipoDescuento TipoDescuento @map("tipo_descuento")
  valor         Decimal       @db.Decimal(10, 2)

  // Monto mínimo de compra, evaluado solo sobre el subtotal de los
  // productos a los que aplica el cupón (no sobre todo el carrito) — ver
  // utils/cupones.js.
  montoMinimo    Decimal?  @map("monto_minimo") @db.Decimal(10, 2)
  fechaInicio    DateTime? @map("fecha_inicio")
  fechaFin       DateTime? @map("fecha_fin")
  // null = sin límite.
  usosMaximos    Int?      @map("usos_maximos")
  usosPorCliente Int?      @map("usos_por_cliente")
  activo         Boolean   @default(true)

  creadoPorId Int?     @map("creado_por_id")
  creadoPor   Usuario? @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productos CuponProducto[]
  usos      CuponUso[]
  pedidos   Pedido[]

  @@map("cupones")
}

// Productos específicos a los que aplica un cupón (relación muchos a
// muchos explícita en vez de implícita, para poder consultarla fácilmente
// desde ambos lados y no perder la fecha en que se agregó cada uno).
model CuponProducto {
  id         Int      @id @default(autoincrement())
  cuponId    Int      @map("cupon_id")
  cupon      Cupon    @relation(fields: [cuponId], references: [id])
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([cuponId, productoId])
  @@map("cupon_productos")
}

// Un renglón por cada vez que un cliente usó un cupón en un pedido — sirve
// para contar usosMaximos/usosPorCliente y para auditar cuánto se descontó
// realmente en cada caso (montoDescontado puede variar entre usos si el
// cupón es de %, según el subtotal aplicable de cada carrito).
model CuponUso {
  id              Int      @id @default(autoincrement())
  cuponId         Int      @map("cupon_id")
  cupon           Cupon    @relation(fields: [cuponId], references: [id])
  clienteId       Int      @map("cliente_id")
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  pedidoId        Int      @unique @map("pedido_id")
  pedido          Pedido   @relation(fields: [pedidoId], references: [id])
  montoDescontado Decimal  @map("monto_descontado") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("cupon_usos")
}

// ---------------------------------------------------------------------------
// Configuración general de la tienda en línea
// ---------------------------------------------------------------------------
//
// Fila única (siempre id=1): ajustes globales que no ameritan su propia
// tabla. Por ahora solo el WhatsApp de contacto para pagos: TODOS los
// pedidos en línea usan siempre este número (ya no se reparte por
// proveedor).
model ConfiguracionTienda {
  id             Int      @id @default(autoincrement())
  whatsappTienda String?  @map("whatsapp_tienda")
  // ID de WhatsApp Business Platform (Cloud API) usado como número general
  // de la tienda cuando una sucursal no tiene uno propio capturado — mismo
  // rol de respaldo que whatsappTienda pero para el envío automático (ver
  // Sucursal.whatsappPhoneNumberId).
  whatsappPhoneNumberId String? @map("whatsapp_phone_number_id")
  // Costo de envío fijo que se suma al total de cada pedido nuevo (ver
  // Pedido.costoEnvio). v1: un solo monto para toda la tienda; a futuro se
  // piensa volver dinámico (por zona, peso, etc.).
  costoEnvio     Decimal  @default(0) @db.Decimal(10, 2) @map("costo_envio")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("configuracion_tienda")
}

// ---------------------------------------------------------------------------
// Reseñas de pedidos en línea
// ---------------------------------------------------------------------------
//
// El cliente puede calificar su pedido una vez que lo marca (o se marca)
// como RECIBIDO: qué tan bien le pareció el/los producto(s) y el envío, con
// comentario y fotos opcionales del paquete tal como llegó — útil tanto de
// prueba social para otros clientes a futuro como de evidencia si hay una
// queja por daños en el envío. Una reseña por pedido (no por artículo).
model PedidoResena {
  id       Int    @id @default(autoincrement())
  pedidoId Int    @unique @map("pedido_id")
  pedido   Pedido @relation(fields: [pedidoId], references: [id])

  calificacionProducto Int     @map("calificacion_producto") // 1 a 5
  calificacionEnvio    Int     @map("calificacion_envio") // 1 a 5
  comentario           String?

  // Si se muestra como testimonio público en la tienda en línea. El cliente
  // no dio consentimiento explícito para que su reseña sea pública al
  // escribirla, así que por default sí se publica (son reseñas normales de
  // compra) pero el negocio puede ocultar cualquiera puntual desde el
  // dashboard (ver routes/resenas.js) — por ejemplo, si trae una queja o una
  // foto que no se preste para mostrarse a otros clientes.
  visible Boolean @default(true)

  fotos     PedidoResenaFoto[]
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("pedido_resenas")
}

model PedidoResenaFoto {
  id       Int          @id @default(autoincrement())
  resenaId Int          @map("resena_id")
  resena   PedidoResena @relation(fields: [resenaId], references: [id])
  url      String
  publicId String       @map("public_id")

  @@map("pedido_resena_fotos")
}
