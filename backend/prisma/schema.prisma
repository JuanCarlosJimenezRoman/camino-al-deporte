// Esquema de base de datos - Camino al Deporte
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles y usuarios
// ---------------------------------------------------------------------------

enum RolNombre {
  ADMIN_PRINCIPAL // acceso total: usuarios, roles, catálogos, inventario, ventas, reportes
  DESARROLLO      // acceso total + puede crear/modificar campos personalizados
  INVENTARIO      // gestiona productos, variantes, entradas/salidas de stock
  VENTAS          // registra ventas, consulta stock, no edita catálogo
  CONSULTA        // solo lectura: existencias y precios
}

model Rol {
  id        Int       @id @default(autoincrement())
  nombre    RolNombre @unique
  descripcion String?
  usuarios  Usuario[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("roles")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("rol_id")
  rol          Rol      @relation(fields: [rolId], references: [id])
  activo       Boolean  @default(true)
  ultimoLogin  DateTime? @map("ultimo_login")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Sucursal "de casa" del usuario. Null para ADMIN_PRINCIPAL/DESARROLLO,
  // que ven todas las sucursales. Para INVENTARIO/VENTAS/CONSULTA acota
  // qué sucursal ve por defecto en el frontend (no es una restricción dura
  // a nivel API todavía, ver docs/ARQUITECTURA.md).
  sucursalId   Int?     @map("sucursal_id")
  sucursal     Sucursal? @relation(fields: [sucursalId], references: [id])

  movimientos  MovimientoInventario[]
  ventas       Venta[]
  transferenciasSolicitadas TransferenciaInventario[] @relation("TransferenciasSolicitadas")
  transferenciasRecibidas   TransferenciaInventario[] @relation("TransferenciasRecibidas")
  apartadosCreados          Apartado[]      @relation("ApartadosCreados")
  pagosApartadoRegistrados  ApartadoPago[]  @relation("PagosApartadoRegistrados")

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Sucursales / bodegas
// ---------------------------------------------------------------------------

model Sucursal {
  id              Int      @id @default(autoincrement())
  nombre          String
  codigo          String?  @unique
  direccion       String?
  telefono        String?
  esBodegaCentral Boolean  @default(false) @map("es_bodega_central")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  usuarios        Usuario[]
  existencias     Existencia[]
  movimientos     MovimientoInventario[]
  ventas          Venta[]
  transferenciasOrigen  TransferenciaInventario[] @relation("TransferenciaOrigen")
  transferenciasDestino TransferenciaInventario[] @relation("TransferenciaDestino")
  apartadosStock  ApartadoItem[] @relation("ApartadoStock")
  apartadosVenta  Apartado[]     @relation("ApartadoVenta")

  @@map("sucursales")
}

// Stock de una variante (talla/color) en una sucursal específica. El
// catálogo (producto/variante/SKU) es global; el stock es por sucursal.
model Existencia {
  id          Int              @id @default(autoincrement())
  sucursalId  Int              @map("sucursal_id")
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id])
  varianteId  Int              @map("variante_id")
  variante    ProductoVariante @relation(fields: [varianteId], references: [id])
  stockActual Int              @default(0) @map("stock_actual")
  stockMinimo Int              @default(0) @map("stock_minimo")

  @@unique([sucursalId, varianteId])
  @@map("existencias")
}

// ---------------------------------------------------------------------------
// Catálogos: marcas, modelos, tallas, categorías
// ---------------------------------------------------------------------------

model Marca {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  modelos   Modelo[]
  productos Producto[]

  @@map("marcas")
}

model Modelo {
  id        Int        @id @default(autoincrement())
  nombre    String
  marcaId   Int        @map("marca_id")
  marca     Marca      @relation(fields: [marcaId], references: [id])
  activo    Boolean    @default(true)
  productos Producto[]

  @@unique([nombre, marcaId])
  @@map("modelos")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]

  @@map("categorias")
}

// Tallas son un catálogo reutilizable (ej: "7", "8.5", "S", "M", "38")
// El campo `tipo` permite agrupar (calzado, ropa, accesorio) para no mezclar
// tallas de zapato con tallas de playera en el mismo selector.
model Talla {
  id       Int               @id @default(autoincrement())
  valor    String
  tipo     String            // "calzado" | "ropa" | "accesorio" | ...
  orden    Int               @default(0)
  variantes ProductoVariante[]

  @@unique([valor, tipo])
  @@map("tallas")
}

// ---------------------------------------------------------------------------
// Productos y variantes (una variante = combinación talla/color con stock propio)
// ---------------------------------------------------------------------------

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  marcaId      Int      @map("marca_id")
  marca        Marca    @relation(fields: [marcaId], references: [id])
  modeloId     Int?     @map("modelo_id")
  modelo       Modelo?  @relation(fields: [modeloId], references: [id])
  categoriaId  Int      @map("categoria_id")
  categoria    Categoria @relation(fields: [categoriaId], references: [id])
  precioCompra Decimal  @default(0) @map("precio_compra") @db.Decimal(10, 2)
  precioVenta  Decimal  @default(0) @map("precio_venta") @db.Decimal(10, 2)
  activo       Boolean  @default(true)

  // Campos personalizados definidos dinámicamente por el rol DESARROLLO
  // sin necesidad de migraciones (ver modelo CampoPersonalizado).
  atributosExtra Json?  @default("{}") @map("atributos_extra")

  variantes    ProductoVariante[]
  imagenes     ProductoImagen[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("productos")
}

// Fotos del producto (no de la variante: la misma foto sirve para todas las
// tallas/colores). Se guardan en Cloudinary; aquí solo vive la URL y el
// public_id necesario para poder borrarlas allá también.
model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  producto    Producto @relation(fields: [productoId], references: [id])
  url         String
  publicId    String   @map("public_id")
  esPrincipal Boolean  @default(false) @map("es_principal")
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("producto_imagenes")
}

model ProductoVariante {
  id            Int      @id @default(autoincrement())
  productoId    Int      @map("producto_id")
  producto      Producto @relation(fields: [productoId], references: [id])
  tallaId       Int?     @map("talla_id")
  talla         Talla?   @relation(fields: [tallaId], references: [id])
  color         String?
  sku           String   @unique
  activo        Boolean  @default(true)

  // El stock ya no vive aquí: cada variante puede tener stock distinto en
  // cada sucursal (ver modelo Existencia).
  existencias   Existencia[]
  movimientos   MovimientoInventario[]
  ventaItems    VentaItem[]
  transferencias TransferenciaInventario[]
  apartadoItems ApartadoItem[]

  @@unique([productoId, tallaId, color])
  @@map("producto_variantes")
}

// ---------------------------------------------------------------------------
// Inventario: historial de movimientos (entradas, salidas, ajustes)
// ---------------------------------------------------------------------------

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  DEVOLUCION
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  APARTADO
}

model MovimientoInventario {
  id          Int              @id @default(autoincrement())
  sucursalId  Int              @map("sucursal_id")
  sucursal    Sucursal         @relation(fields: [sucursalId], references: [id])
  varianteId  Int              @map("variante_id")
  variante    ProductoVariante @relation(fields: [varianteId], references: [id])
  tipo        TipoMovimiento
  cantidad    Int              // positivo o negativo según tipo
  motivo      String?
  usuarioId   Int              @map("usuario_id")
  usuario     Usuario          @relation(fields: [usuarioId], references: [id])

  // Si el movimiento vino de una transferencia entre sucursales
  transferenciaId Int?         @map("transferencia_id")
  transferencia   TransferenciaInventario? @relation(fields: [transferenciaId], references: [id])

  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("movimientos_inventario")
}

// ---------------------------------------------------------------------------
// Transferencias de mercancía entre sucursales
// ---------------------------------------------------------------------------

enum EstadoTransferencia {
  SOLICITADA  // creada, stock ya descontado del origen, en camino
  RECIBIDA    // confirmada en destino, stock ya sumado al destino
  CANCELADA   // cancelada antes de recibirse, stock devuelto al origen
}

model TransferenciaInventario {
  id                Int      @id @default(autoincrement())
  folio             String   @unique
  varianteId        Int      @map("variante_id")
  variante          ProductoVariante @relation(fields: [varianteId], references: [id])
  cantidad          Int
  sucursalOrigenId  Int      @map("sucursal_origen_id")
  sucursalOrigen    Sucursal @relation("TransferenciaOrigen", fields: [sucursalOrigenId], references: [id])
  sucursalDestinoId Int      @map("sucursal_destino_id")
  sucursalDestino   Sucursal @relation("TransferenciaDestino", fields: [sucursalDestinoId], references: [id])
  estado            EstadoTransferencia @default(SOLICITADA)
  solicitadoPorId   Int      @map("solicitado_por_id")
  solicitadoPor     Usuario  @relation("TransferenciasSolicitadas", fields: [solicitadoPorId], references: [id])
  recibidoPorId     Int?     @map("recibido_por_id")
  recibidoPor       Usuario? @relation("TransferenciasRecibidas", fields: [recibidoPorId], references: [id])
  notas             String?
  createdAt         DateTime @default(now()) @map("created_at")
  recibidoAt        DateTime? @map("recibido_at")

  movimientos       MovimientoInventario[]

  @@map("transferencias_inventario")
}

// ---------------------------------------------------------------------------
// Pagos: método de pago y cuentas donde se reciben transferencias
// ---------------------------------------------------------------------------

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

// Catálogo de cuentas bancarias propias donde se reciben transferencias
// (ej. "BBVA Tienda", "Santander Sucursal Centro"). Es del negocio en
// general, no de una sucursal en particular, porque normalmente unas pocas
// cuentas se comparten entre todas las sucursales.
model CuentaTransferencia {
  id           Int      @id @default(autoincrement())
  nombre       String   // etiqueta visible, ej. "BBVA Tienda"
  banco        String?
  titular      String?
  numeroCuenta String?  @map("numero_cuenta") // CLABE o número de cuenta/tarjeta
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  ventas       Venta[]
  pagosApartado ApartadoPago[]

  @@map("cuentas_transferencia")
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

enum EstadoVenta {
  COMPLETADA
  CANCELADA
  PENDIENTE
}

model Venta {
  id          Int         @id @default(autoincrement())
  folio       String      @unique
  sucursalId  Int         @map("sucursal_id")
  sucursal    Sucursal    @relation(fields: [sucursalId], references: [id])
  usuarioId   Int         @map("usuario_id")
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
  cliente     String?
  total       Decimal     @default(0) @db.Decimal(10, 2)

  metodoPago  MetodoPago  @default(EFECTIVO) @map("metodo_pago")
  // Solo aplica cuando metodoPago = TRANSFERENCIA
  cuentaTransferenciaId Int? @map("cuenta_transferencia_id")
  cuentaTransferencia   CuentaTransferencia? @relation(fields: [cuentaTransferenciaId], references: [id])
  comprobanteUrl        String? @map("comprobante_url")
  comprobantePublicId   String? @map("comprobante_public_id")

  estado      EstadoVenta @default(COMPLETADA)
  items       VentaItem[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("ventas")
}

model VentaItem {
  id             Int              @id @default(autoincrement())
  ventaId        Int              @map("venta_id")
  venta          Venta            @relation(fields: [ventaId], references: [id])
  varianteId     Int              @map("variante_id")
  variante       ProductoVariante @relation(fields: [varianteId], references: [id])
  cantidad       Int
  precioUnitario Decimal          @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal          @db.Decimal(10, 2)

  @@map("venta_items")
}

// ---------------------------------------------------------------------------
// Campos personalizados (para que el rol DESARROLLO agregue campos a futuro
// sin tocar código): describe qué campos extra existen para cada entidad y
// cómo debe renderizarlos el frontend. Los valores reales viven en el JSON
// `atributosExtra` de cada registro.
// ---------------------------------------------------------------------------

enum TipoCampo {
  TEXTO
  NUMERO
  BOOLEANO
  FECHA
  SELECT
}

model CampoPersonalizado {
  id          Int       @id @default(autoincrement())
  entidad     String    // "producto" | "producto_variante" | ...
  clave       String    // nombre interno del campo, ej: "genero"
  etiqueta    String    // texto visible, ej: "Género"
  tipo        TipoCampo
  opciones    Json?     // para SELECT: ["Hombre","Mujer","Unisex"]
  requerido   Boolean   @default(false)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([entidad, clave])
  @@map("campos_personalizados")
}

// ---------------------------------------------------------------------------
// Clientes y apartados (layaway)
// ---------------------------------------------------------------------------

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String   @unique // clave natural para buscar/evitar duplicar clientes
  email     String?
  notas     String?
  createdAt DateTime @default(now()) @map("created_at")

  apartados Apartado[]

  @@map("clientes")
}

enum EstadoApartado {
  ACTIVO     // tiene saldo pendiente, stock ya reservado
  LIQUIDADO  // ya se pagó completo (pendiente de entregar o ya entregado)
  CANCELADO  // se canceló, stock devuelto a la sucursal de origen
}

// Un apartado puede incluir varios productos (ApartadoItem), cada uno
// reservado desde la sucursal donde físicamente está ese stock — no
// necesariamente la misma sucursal donde el cliente está apartando.
model Apartado {
  id              Int            @id @default(autoincrement())
  folio           String         @unique
  clienteId       Int            @map("cliente_id")
  cliente         Cliente        @relation(fields: [clienteId], references: [id])

  // Sucursal/vendedor que atiende al cliente y hace el apartado (no
  // necesariamente donde está el stock de cada artículo, ver ApartadoItem).
  sucursalVentaId Int            @map("sucursal_venta_id")
  sucursalVenta   Sucursal       @relation("ApartadoVenta", fields: [sucursalVentaId], references: [id])

  total           Decimal        @default(0) @db.Decimal(10, 2)
  estado          EstadoApartado @default(ACTIVO)
  fechaLimite     DateTime?      @map("fecha_limite")
  notas           String?

  creadoPorId     Int            @map("creado_por_id")
  creadoPor       Usuario        @relation("ApartadosCreados", fields: [creadoPorId], references: [id])

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  items           ApartadoItem[]
  pagos           ApartadoPago[]

  @@map("apartados")
}

model ApartadoItem {
  id              Int              @id @default(autoincrement())
  apartadoId      Int              @map("apartado_id")
  apartado        Apartado         @relation(fields: [apartadoId], references: [id])
  varianteId      Int              @map("variante_id")
  variante        ProductoVariante @relation(fields: [varianteId], references: [id])

  // Sucursal de donde se descontó el stock al crear el apartado.
  sucursalStockId Int              @map("sucursal_stock_id")
  sucursalStock   Sucursal         @relation("ApartadoStock", fields: [sucursalStockId], references: [id])

  cantidad        Int
  precioUnitario  Decimal          @map("precio_unitario") @db.Decimal(10, 2)
  subtotal        Decimal          @db.Decimal(10, 2)

  @@map("apartado_items")
}

// Abonos del cliente hacia un apartado. saldo pendiente = apartado.total -
// suma(monto) de estos pagos — se calcula al vuelo, no se guarda cacheado.
model ApartadoPago {
  id                    Int      @id @default(autoincrement())
  apartadoId            Int      @map("apartado_id")
  apartado              Apartado @relation(fields: [apartadoId], references: [id])
  monto                 Decimal  @db.Decimal(10, 2)

  metodoPago            MetodoPago @default(EFECTIVO) @map("metodo_pago")
  cuentaTransferenciaId Int?     @map("cuenta_transferencia_id")
  cuentaTransferencia   CuentaTransferencia? @relation(fields: [cuentaTransferenciaId], references: [id])
  comprobanteUrl        String?  @map("comprobante_url")
  comprobantePublicId   String?  @map("comprobante_public_id")

  registradoPorId       Int      @map("registrado_por_id")
  registradoPor         Usuario  @relation("PagosApartadoRegistrados", fields: [registradoPorId], references: [id])

  createdAt             DateTime @default(now()) @map("created_at")

  @@map("apartado_pagos")
}
