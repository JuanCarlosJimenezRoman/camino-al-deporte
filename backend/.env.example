# PostgreSQL (Render: usar la "Internal Database URL" si el backend vive en el mismo proyecto)
DATABASE_URL=postgresql://usuario:password@host:5432/camino_al_deporte

# Servidor
PORT=4000
NODE_ENV=production
APP_URL=https://tu-backend.onrender.com

# Autenticación
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# CORS - dominio del frontend (Vercel/Render)
FRONTEND_URL=https://tu-frontend.vercel.app

# Usuario administrador inicial (usado solo por prisma/seed.js)
SEED_ADMIN_EMAIL=admin@caminoaldeporte.com
SEED_ADMIN_PASSWORD=cambia-esta-password
SEED_ADMIN_NOMBRE=Administrador Principal

# Cloudinary (fotos de producto) - dashboard.cloudinary.com > Account Details
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# KicksDB (kicks.dev) - catálogo externo de sneakers para dar de alta
# productos por búsqueda (nombre/SKU) en vez de capturar todo a mano. Se
# saca en https://kicks.dev/api-keys (hay plan gratis, 1,000 requests/mes).
# Mientras esté vacío, GET /productos/buscar-externo responde 503 pero el
# resto del sistema sigue funcionando normal. Ver docs/ARQUITECTURA.md.
KICKSDB_API_KEY=

# WhatsApp Business Platform (Cloud API de Meta) - envío automático del
# ticket digital (PDF) al cliente. Mientras WHATSAPP_ACCESS_TOKEN esté
# vacío, el sistema sigue funcionando con el botón manual de "Enviar ticket
# por WhatsApp" y el PDF se puede ver/descargar aparte (no rompe nada
# dejarlo así). Ver docs/whatsapp-api-ticket-digital.md para la guía
# completa (incluye habilitar PDF en Cloudinary, paso aparte).
# Token permanente del System User (Meta Business Manager > Configuración
# del negocio > Usuarios del sistema).
WHATSAPP_ACCESS_TOKEN=
# Nombre y forma en que se dio de alta la plantilla del ticket ante Meta
# (con header tipo "Documento" para el PDF).
WHATSAPP_TICKET_TEMPLATE_NAME=ticket_digital_compra_pdf
WHATSAPP_TICKET_TEMPLATE_LANG=es_MX
# Nombre y forma en que se dio de alta la plantilla de "olvidé mi
# contraseña" ante Meta. A diferencia de la del ticket, esta es categoría
# AUTHENTICATION (Meta la exige así para este tipo de contenido, no deja
# usar "utility" con un link): cuerpo con el texto fijo de Meta tipo "{{1}}
# es tu código de verificación" + botón OTP de "Copiar código", sin header
# ni link. Además de aprobar la plantilla, AUTHENTICATION exige que el
# negocio tenga completada la verificación de Meta Business y un mínimo de
# conversaciones iniciadas por día — si Meta la rechaza por eso, no hay nada
# que ajustar en el sistema, es un requisito de la cuenta.
# Mientras WHATSAPP_ACCESS_TOKEN esté vacío o no se apruebe esta plantilla,
# /tienda/auth/olvide-password sigue respondiendo 200 (para no revelar si el
# correo existe) pero no se manda ningún mensaje.
WHATSAPP_RESET_TEMPLATE_NAME=recuperar_password_cliente
WHATSAPP_RESET_TEMPLATE_LANG=es_MX

# Correo (Gmail SMTP) - canal PRINCIPAL para mandar el código de "olvidé mi
# contraseña" a los clientes: no depende de que Meta apruebe ninguna
# plantilla, funciona desde el primer día. Ver docs/recuperacion-password-correo-gmail.md
# para la guía paso a paso (generar la contraseña de aplicación en Gmail).
# Mientras EMAIL_USER/EMAIL_APP_PASSWORD estén vacíos, el sistema sigue
# funcionando (no rompe nada), solo no llega el correo — y si WhatsApp sí
# está configurado (arriba), el código igual llega por ese otro canal.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NOMBRE=Camino al Deporte
# Nombre y forma en que se dio de alta la plantilla del comprobante de
# apartado ante Meta (header tipo "Documento" para el PDF) — se manda al
# crear un apartado y cada vez que se registra un abono. Es una plantilla
# APARTE de la del ticket de venta: el texto es distinto (menciona saldo
# pendiente, no "gracias por tu compra") y Meta no permite reutilizar un
# nombre de plantilla ya aprobado con un cuerpo diferente.
# Mientras WHATSAPP_ACCESS_TOKEN esté vacío o esta plantilla no esté
# aprobada, el apartado/abono se registra igual y se ofrece el botón manual
# de "Enviar comprobante por WhatsApp" (no rompe nada dejarlo así).
WHATSAPP_APARTADO_TEMPLATE_NAME=comprobante_apartado_pdf
WHATSAPP_APARTADO_TEMPLATE_LANG=es_MX
